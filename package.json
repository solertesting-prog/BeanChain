{
  "name": "beanchain",
  "private": true,
  "version": "0.1.0",
  "description": "BeanChain: prefinanciación de cosechas de cacao y café con security tokens ERC-3643",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "contracts:test": "pnpm --filter @beanchain/contracts test",
    "contracts:node": "pnpm --filter @beanchain/contracts node",
    "contracts:deploy:local": "pnpm --filter @beanchain/contracts deploy:local",
    "api:dev": "pnpm --filter @beanchain/api start:dev",
    "web:dev": "pnpm --filter @beanchain/web dev",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @beanchain/api prisma:migrate",
    "db:seed": "pnpm --filter @beanchain/api prisma:seed"
  }
}
